#!/data/data/com.termux/files/usr/bin/bash
# Generated by install_home_shortcuts.sh

clear
banner() {
    echo "========================================"
    echo "$1"
    echo "========================================"
    echo ""
}
wait_key() {
    echo ""
    read -n 1 -s -r -p "Tap any key to close..." || true
    echo ""
}
notify() {
    termux-toast "$1" 2>/dev/null || true
}

banner "CryptoScanner - Wallet Scanner"
export ALCHEMY_API_KEY="${ALCHEMY_API_KEY:-mi8wM6xm7rRBMYTCjHfM5}"

SCAN_RESULTS="$HOME/.trufflehog_results.jsonl"
: > "$SCAN_RESULTS"
mkdir -p "$HOME/.run_pids"
PIDFILE="$HOME/.run_pids/crypto_scanner.pid"

if [ -f "$PIDFILE" ] && kill -0 "$(cat "$PIDFILE")" 2>/dev/null; then
    echo "[*] Wallet scanner already running (PID $(cat "$PIDFILE"))"
    notify "Wallet scanner already running"
else
    rm -f "$PIDFILE"
    nohup setsid python3 "$HOME/crypto_scanner.py" "$SCAN_RESULTS" >> "$HOME/crypto_scanner_scanner.log" 2>&1 </dev/null &
    echo $! > "$PIDFILE"
    echo "[+] Wallet scanner started (PID $(cat "$PIDFILE"))"
    notify "Wallet scanner started"
    sleep 1
fi

echo ""
echo "Recent scanner output:"
tail -n 25 "$HOME/crypto_scanner_scanner.log" 2>/dev/null || echo "[no log yet]"
echo ""
echo "Log file: $HOME/crypto_scanner_scanner.log"
echo "Status:   $HOME/crypto_scanner_status.txt"
echo "Hits:     $HOME/high_confidence_hits.jsonl"
wait_key
