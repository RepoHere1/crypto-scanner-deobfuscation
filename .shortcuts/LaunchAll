#!/data/data/com.termux/files/usr/bin/bash
# LaunchAll - One-tap Android shortcut for the unified pipeline.

clear
banner() {
    echo "========================================"
    echo "$1"
    echo "========================================"
    echo ""
}
wait_key() {
    echo ""
    read -n 1 -s -r -p "Tap any key to close..." || true
    echo ""
}
notify() {
    termux-toast "$1" 2>/dev/null || true
}

banner "LaunchAll - Running pipeline"

notify "Launching pipeline..."
python3 "$HOME/pipeline.py" 2>&1 | tee "$HOME/.last_launchall.log"
EXIT_CODE="${PIPESTATUS[0]}"

if [ "$EXIT_CODE" -ne 0 ]; then
    notify "Pipeline failed (code $EXIT_CODE)"
    echo ""
    echo "[!] Pipeline exited with code $EXIT_CODE"
else
    notify "Pipeline started; services running"
fi

echo ""
echo "Recent pipeline log:"
tail -n 30 "$HOME/pipeline.log" 2>/dev/null || echo "[no log yet]"
echo ""
echo "Services are running in the background."
wait_key
