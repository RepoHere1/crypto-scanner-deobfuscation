#!/data/data/com.termux/files/usr/bin/bash
# ScannerStatus - One-tap Android shortcut showing unified pipeline status.

clear
banner() {
    echo "========================================"
    echo "$1"
    echo "========================================"
    echo ""
}
wait_key() {
    echo ""
    read -n 1 -s -r -p "Tap any key to close..." || true
    echo ""
}
notify() {
    termux-toast "$1" 2>/dev/null || true
}

banner "Scanner Status"

# Compact one-line status for the toast notification.
COMPACT="$(python3 "$HOME/scanstatus.py" --compact 2>/dev/null || echo 'status unavailable')"
notify "$COMPACT"

# Full status table.
python3 "$HOME/pipeline.py" --status

echo ""
echo "Recent crypto scanner log:"
tail -n 15 "$HOME/crypto_scanner_scanner.log" 2>/dev/null || echo "[no log yet]"
wait_key
