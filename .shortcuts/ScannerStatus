#!/data/data/com.termux/files/usr/bin/bash
# Generated by install_home_shortcuts.sh

clear
banner() {
    echo "========================================"
    echo "$1"
    echo "========================================"
    echo ""
}
wait_key() {
    echo ""
    read -n 1 -s -r -p "Tap any key to close..." || true
    echo ""
}
notify() {
    termux-toast "$1" 2>/dev/null || true
}

banner "Scanner Status"

STATUS_FILE="$HOME/crypto_scanner_status.txt"
PIDFILE="$HOME/.run_pids/crypto_scanner.pid"
MASS_PIDFILE="$HOME/.run_pids/mass_scan.pid"

if [ -f "$PIDFILE" ] && kill -0 "$(cat "$PIDFILE")" 2>/dev/null; then
    echo "Crypto scanner: RUNNING (PID $(cat "$PIDFILE"))"
else
    echo "Crypto scanner: STOPPED"
fi

if [ -f "$MASS_PIDFILE" ] && kill -0 "$(cat "$MASS_PIDFILE")" 2>/dev/null; then
    echo "Mass scan:      RUNNING (PID $(cat "$MASS_PIDFILE"))"
else
    echo "Mass scan:      STOPPED"
fi

echo ""
if [ -f "$STATUS_FILE" ]; then
    STATUS="$(cat "$STATUS_FILE")"
    echo "Last status:"
    echo "$STATUS"
    notify "$STATUS"
else
    echo "[*] No status file yet"
    notify "No status yet"
fi

echo ""
echo "Recent log tail:"
tail -n 15 "$HOME/crypto_scanner_scanner.log" 2>/dev/null || echo "[no log yet]"
wait_key
