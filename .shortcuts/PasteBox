#!/data/data/com.termux/files/usr/bin/bash
# Generated by install_home_shortcuts.sh

clear
banner() {
    echo "========================================"
    echo "$1"
    echo "========================================"
    echo ""
}
wait_key() {
    echo ""
    read -n 1 -s -r -p "Tap any key to close..." || true
    echo ""
}
notify() {
    termux-toast "$1" 2>/dev/null || true
}

banner "PasteBox - Processing input"
notify "Processing paste box..."
python3 "$HOME/paste_box.py"
notify "Paste box processed"

echo ""
echo "=== Summary ==="
printf "GitHub targets:  "; wc -l < "$HOME/paste.txt" 2>/dev/null || echo 0
printf "Crypto findings: "; wc -l < "$HOME/.trufflehog_results.jsonl" 2>/dev/null || echo 0
printf "RPC endpoints:   "; wc -l < "$HOME/rpc_endpoints.jsonl" 2>/dev/null || echo 0
printf "API keys:        "; wc -l < "$HOME/api_keys.jsonl" 2>/dev/null || echo 0

echo ""
echo "Next step: tap CryptoScanner (wallet scanner) to scan the findings."
wait_key
