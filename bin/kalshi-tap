#!/data/data/com.termux/files/usr/bin/bash
# KALSHI Tap — automated crypto prediction market trading
#
# Usage:
#   kalshi-tap                     Hedge watch (live contrarian pair monitor)
#   kalshi-tap --hedge             One-shot hedge scan (full detail)
#   kalshi-tap --tui               Interactive TUI dashboard
#   kalshi-tap --live              One-shot analysis + execute trades
#   kalshi-tap --status            Check API connectivity and balance
#   kalshi-tap --setup             Print API key setup instructions
#   kalshi-tap --series KXETHD --hedge   ETH hedge scan
#   kalshi-tap --hedge-watch --hedge-max-tte 60   Near-expiry only
#
# Aliases: kslshi, kal-tap, kalshi-tap (case-insensitive)

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
PROJECT_DIR="$(dirname "$SCRIPT_DIR")"
export PYTHONPATH="$PROJECT_DIR:$PYTHONPATH"

# --- Kalshi API credentials (self-contained — no .bashrc sourcing needed) ---
export KALSHI_API_KEY_ID='dc817127-84ab-4451-bf34-c794c9dcfe98'
export KALSHI_PRIVATE_KEY_PATH="$HOME/.kalshi/private_key.pem"

# Ensure unbuffered output for live watch mode
export PYTHONUNBUFFERED=1

# --- Dispatch ---
if [ $# -eq 0 ]; then
    # Default: hedge watch — live contrarian pair monitor
    exec python3 "$PROJECT_DIR/kalshi_tap/cli.py" --hedge-watch --hedge-no-cache
fi

exec python3 "$PROJECT_DIR/kalshi_tap/cli.py" "$@"
