{
  "target_intelligence": {
    "enabled": true,
    "success_rate_decay": 0.95,
    "max_history_days": 30
  },
  "deobfuscation": {
    "enabled": true,
    "techniques": [
      "backspace_processing",
      "character_substitution", 
      "base64_decoding",
      "string_reversal"
    ]
  },
  "adaptive_throttling": {
    "enabled": true,
    "base_delays": {
      "github": 1.0,
      "gitlab": 1.5,
      "huggingface": 2.0,
      "docker": 1.0,
      "circleci": 1.0,
      "postman": 1.5,
      "aws_s3": 0.5,
      "gcs": 0.8,
      "jenkins": 2.0,
      "elasticsearch": 1.2,
      "syslog": 1.0
    },
    "max_delays": {
      "github": 10.0,
      "gitlab": 15.0,
      "huggingface": 20.0,
      "docker": 10.0,
      "circleci": 8.0,
      "postman": 12.0,
      "aws_s3": 5.0,
      "gcs": 8.0,
      "jenkins": 20.0,
      "elasticsearch": 12.0,
      "syslog": 10.0
    }
  },
  "result_verification": {
    "enabled": true,
    "confidence_threshold": 0.5,
    "cache_ttl_hours": 24
  },
  "resource_management": {
    "enabled": true,
    "cpu_threshold_percent": 80,
    "memory_threshold_percent": 85,
    "disk_threshold_percent": 90,
    "min_free_memory_mb": 100
  }
}