# Environment template for the crypto-scanner / deobfuscation pipeline.
#
# Copy this file to ~/.env and fill in the values for the platforms you want to
# scan.  No real secrets or fake credentials belong in this repository; keep
# ~/.env out of version control (it is already ignored by .gitignore).
#
#   cp ~/.env.template ~/.env
#   nano ~/.env          # fill in your values
#   source ~/.env        # load in the current shell
#
# The pipeline runs fine in "dry" mode without any of these values; tokens are
# only needed when you want to scan private resources or use authenticated APIs.

# -----------------------------------------------------------------------------
# 1. GitHub
# -----------------------------------------------------------------------------
# Personal access token with repo / read:org scopes for private repos.
GITHUB_TOKEN=your_github_token_here

# -----------------------------------------------------------------------------
# 2. GitLab
# -----------------------------------------------------------------------------
# Personal access token with read_api / read_repository scopes.
GITLAB_TOKEN=your_gitlab_token_here

# -----------------------------------------------------------------------------
# 3. Hugging Face
# -----------------------------------------------------------------------------
# Access token from https://huggingface.co/settings/tokens (read-only is enough).
HUGGINGFACE_TOKEN=your_huggingface_token_here

# -----------------------------------------------------------------------------
# 4. Jenkins
# -----------------------------------------------------------------------------
# Base URL of your Jenkins instance (e.g. https://jenkins.example.com/).
JENKINS_URL=https://jenkins.example.com/
# Jenkins user name for API calls.
JENKINS_USER=your_jenkins_user
# Jenkins API token for the user above.
JENKINS_TOKEN=your_jenkins_token

# -----------------------------------------------------------------------------
# 5. Elasticsearch
# -----------------------------------------------------------------------------
# Cluster URL (e.g. https://my-cluster.es.us-east-1.aws.found.io:9243).
ELASTICSEARCH_URL=https://elasticsearch.example.com:9200
# API key created in Kibana / Elasticsearch (Base64 encoded).
ELASTICSEARCH_API_KEY=your_elasticsearch_api_key

# -----------------------------------------------------------------------------
# 6. Postman
# -----------------------------------------------------------------------------
# Postman API key from https://web.postman.co/settings/me/api-keys.
POSTMAN_API_KEY=your_postman_api_key

# -----------------------------------------------------------------------------
# 7. AWS
# -----------------------------------------------------------------------------
# IAM access key ID with read-only access to the S3 buckets / resources scanned.
AWS_ACCESS_KEY_ID=your_aws_access_key_id
# Corresponding secret access key.
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key

# -----------------------------------------------------------------------------
# 8. CircleCI
# -----------------------------------------------------------------------------
# Personal API token from https://app.circleci.com/settings/user/tokens.
CIRCLECI_TOKEN=your_circleci_token

# -----------------------------------------------------------------------------
# 9. Docker Hub
# -----------------------------------------------------------------------------
# Docker Hub username.
DOCKERHUB_USERNAME=your_dockerhub_username
# Docker Hub access token (recommended) or password.
DOCKERHUB_TOKEN=your_dockerhub_token

# -----------------------------------------------------------------------------
# 10. Syslog
# -----------------------------------------------------------------------------
# Hostname or IP of the syslog server used for forwarding alerts.
SYSLOG_HOST=syslog.example.com
# Port the syslog server listens on (default 514).
SYSLOG_PORT=514

# -----------------------------------------------------------------------------
# 11. Google Cloud Storage (GCS)
# -----------------------------------------------------------------------------
# GCP project ID that owns the buckets scanned.
GCS_PROJECT_ID=your-gcp-project-id
# Path to a service-account JSON key file, or the raw JSON key contents.
GCS_SERVICE_ACCOUNT_KEY=/path/to/service-account-key.json
